# ペンタブレット（Wacom One M）の設定 — CLIP STUDIO PAINT / Wine
# 保存すると 1 秒以内に動作中の転送プログラムへ反映されます。
# すぐ反映したい場合:  ~/ClipStudio/bin/pentab.sh --reload
# 設定画面:            ~/デスクトップ/clip/pentab/pentab-settings.py
# 現在値の確認:        ~/ClipStudio/bin/pentab.sh --show

[map]
# タブレットの読み取り範囲を画面のどこに対応させるか
#   full   = 画面全体（既定）
#   aspect = アスペクト比を維持（画面中央に配置。描いた円が円になる）
#   area   = 指定した画面領域（下の area_x / area_y / area_width / area_height）
mode = aspect  # 対応マップ
# タブレットの回転（0 / 90 / 180 / 270 度）
rotate = 0  # 回転
# mode = area のときに使う画面領域（ピクセル単位。この画面は 1920x1080）
area_x = 0  # 領域の左端
area_y = 0  # 領域の上端
area_width = 0  # 領域の幅（0 で画面いっぱい）
area_height = 0  # 領域の高さ（0 で画面いっぱい）
# ペンデバイスの排他占有（on / off）
#   on  = デスクトップ側のペン対応マップを止め、このプログラムの式だけが
#         カーソルを動かす（アスペクト比維持でカーソルが2個に分裂する問題の対策）
#   off = デスクトップ側と共存（従来通り。カーソルが分裂することがあります）
grab = off  # 排他占有

[pressure]
# 筆圧の感度。1.0 が等倍。大きくすると弱い力で濃く・太くなる
gain = 1  # 感度
# 筆圧カーブ。1.0 が線形。1 未満でやわらかい（弱い力から濃くなる）、超えると硬い
gamma = 1  # カーブ
# 反応を始める筆圧（0〜1）。0 で触れた瞬間から反応
input_floor = 0  # 反応開始
# 最大筆圧に達する入力（0〜1）。1.0 でストロークの最後まで使い切る
input_ceiling = 1  # 最大入力
# 触れた瞬間の最小出力（0〜1）。線の始まりがかすれるときに上げる
output_floor = 0  # 最小出力

[pen]
# サイドスイッチ（ペン軸のボタン）が送るボタン
#   right  = 右クリック（既定）
#   middle = 中クリック
#   none   = 送らない
side_button = none  # サイドスイッチ
